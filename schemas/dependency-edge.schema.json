{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:dependency-edge",
  "title": "Auditable dependency edge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from", "to", "product_or_process", "relationship_type", "relationship_scope", "epistemic_type", "status", "effective_from", "effective_to", "qualification_status", "customer_status", "evidence_ids", "counterevidence_ids", "alternative_edges", "confidence"],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "product_or_process": { "type": "string", "minLength": 2 },
    "relationship_type": { "type": "string", "minLength": 2 },
    "relationship_scope": { "type": "string", "minLength": 2 },
    "epistemic_type": { "type": "string", "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNKNOWN"] },
    "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED"] },
    "effective_from": { "type": ["string", "null"], "format": "date-time" },
    "effective_to": { "type": ["string", "null"], "format": "date-time" },
    "qualification_status": { "type": "string", "enum": ["QUALIFIED", "IN_PROGRESS", "NOT_QUALIFIED", "UNKNOWN"] },
    "customer_status": { "type": "string", "enum": ["CONFIRMED", "ISSUER_REPORTED", "INFERRED", "UNCONFIRMED", "UNKNOWN"] },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "counterevidence_ids": { "type": "array", "items": { "type": "string" } },
    "alternative_edges": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
