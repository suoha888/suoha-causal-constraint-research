{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:research-case-v1.1",
  "title": "Research case v1.1",
  "description": "Canonical contract for a dated, data-availability-aware causal constraint research case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "as_of",
    "research_cutoff",
    "question",
    "security_identity",
    "data_availability",
    "system_shift",
    "claims",
    "claim_evidence_links",
    "evidence",
    "metrics",
    "calculations",
    "capital_bridges",
    "constraints",
    "edges",
    "customer_signals",
    "issuers",
    "expectation_gap",
    "geo_policy_risk",
    "reflexivity_audit",
    "gates",
    "countercases",
    "disproof_plans",
    "classification",
    "current_state",
    "transitions"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "case_id": { "type": "string", "minLength": 3 },
    "as_of": { "type": "string", "format": "date-time" },
    "research_cutoff": { "type": "string", "format": "date-time" },
    "question": { "type": "string", "minLength": 10 },
    "security_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "legal_name", "ticker", "exchange", "security_type", "primary_listing", "trading_currency", "status"],
      "properties": {
        "issuer_id": { "type": "string", "minLength": 3 },
        "legal_name": { "type": "string", "minLength": 2 },
        "ticker": { "type": "string", "minLength": 1 },
        "exchange": { "type": "string", "minLength": 2 },
        "mic": { "type": ["string", "null"] },
        "security_type": { "type": "string", "minLength": 2 },
        "primary_listing": { "type": "string", "minLength": 2 },
        "country": { "type": ["string", "null"] },
        "trading_currency": { "type": "string", "minLength": 3 },
        "reporting_currency": { "type": ["string", "null"] },
        "regulator_id": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "UNKNOWN"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data_availability": { "$ref": "data-availability.schema.json" },
    "system_shift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "description", "status", "evidence_ids"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 10 },
        "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED", "UNKNOWN"] },
        "event_date": { "type": ["string", "null"], "format": "date-time" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "claim.schema.json" } },
    "claim_evidence_links": { "type": "array", "minItems": 1, "items": { "$ref": "claim-evidence-link.schema.json" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "source-record.schema.json" } },
    "metrics": { "type": "array", "items": { "$ref": "dated-metric.schema.json" } },
    "calculations": { "type": "array", "items": { "$ref": "calculation-record.schema.json" } },
    "capital_bridges": { "type": "array", "items": { "$ref": "capital-bridge.schema.json" } },
    "constraints": { "type": "array", "minItems": 1, "items": { "$ref": "constraint-assessment.schema.json" } },
    "edges": { "type": "array", "items": { "$ref": "dependency-edge.schema.json" } },
    "customer_signals": { "type": "array", "items": { "$ref": "customer-signal.schema.json" } },
    "issuers": { "type": "array", "minItems": 1, "items": { "$ref": "issuer-profile.schema.json" } },
    "expectation_gap": { "$ref": "expectation-gap.schema.json" },
    "geo_policy_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "status", "assessment", "evidence_ids"],
      "properties": {
        "risk_id": { "type": "string", "minLength": 3 },
        "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "UNKNOWN", "NOT_ESTABLISHED"] },
        "assessment": { "type": "string", "minLength": 3 },
        "manufacturing_geography": { "type": "array", "items": { "type": "string" } },
        "supplier_geography": { "type": "array", "items": { "type": "string" } },
        "policy_dependencies": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reflexivity_audit": { "$ref": "market-reflexivity-audit.schema.json" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G0_identity_time", "G1_system_necessity", "G2_dependency_edge", "G3_substitution_bypass", "G4_supply_constraint", "G5_customer_validation", "G6_issuer_capture", "G7_financial_transmission", "G8_market_expectation", "G9_geo_policy", "G10_reflexivity_disproof"],
      "patternProperties": {
        "^G[0-9]+_": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason", "evidence_ids"],
          "properties": {
            "state": { "type": "string", "enum": ["PASS", "PARTIAL", "UNKNOWN", "STALE", "FAIL", "CONTRADICTED"] },
            "reason": { "type": "string", "minLength": 3 },
            "evidence_ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "countercases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "claim", "status", "evidence_ids", "disproof_plan_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "severity": { "type": "string", "enum": ["LOCAL", "MATERIAL", "FATAL"] },
          "claim": { "type": "string", "minLength": 5 },
          "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED", "UNKNOWN"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "disproof_plan_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disproof_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target_claim_id", "observable", "threshold", "time_window", "effect_on_case"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "target_claim_id": { "type": "string", "minLength": 3 },
          "observable": { "type": "string", "minLength": 3 },
          "threshold": { "type": "string", "minLength": 1 },
          "time_window": { "type": "string", "minLength": 1 },
          "source_class": { "type": "string", "minLength": 2 },
          "effect_on_case": { "type": "string", "minLength": 3 }
        }
      }
    },
    "classification": { "type": "string", "enum": ["MAP_ONLY", "CONSTRAINT_CASE", "CUSTOMER_VALIDATED_CASE", "OPERATING_CASE", "VARIANT_CASE", "RESEARCH_READY", "INVALIDATED"] },
    "current_state": { "type": "string", "enum": ["DRAFT", "EVIDENCE_BUILDING", "TESTABLE", "SUPPORTED", "STRENGTHENED", "WEAKENED", "REVISED", "INVALIDATED", "CLOSED"] },
    "transitions": { "type": "array", "items": { "$ref": "case-transition.schema.json" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
