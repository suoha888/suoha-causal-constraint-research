{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:research-case",
  "title": "Legacy v1 research case (compatibility)",
  "$comment": "New cases must use research-case-v1.1.schema.json, which composes canonical claim, evidence, metric, supply, market, and gate contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "as_of",
    "research_cutoff",
    "question",
    "system_shift",
    "constraints",
    "edges",
    "issuers",
    "evidence",
    "gates",
    "countercases",
    "disproof_plans",
    "current_state",
    "transitions"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "case_id": { "type": "string", "minLength": 3 },
    "as_of": { "type": "string", "format": "date" },
    "research_cutoff": { "type": "string", "format": "date" },
    "question": { "type": "string", "minLength": 10 },
    "system_shift": { "$ref": "#/definitions/system_shift" },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/definitions/constraint" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    },
    "issuers": {
      "type": "array",
      "items": { "$ref": "#/definitions/issuer" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence" }
    },
    "gates": { "$ref": "#/definitions/gates" },
    "countercases": {
      "type": "array",
      "items": { "$ref": "#/definitions/countercase" }
    },
    "disproof_plans": {
      "type": "array",
      "items": { "$ref": "#/definitions/disproof_plan" }
    },
    "current_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "EVIDENCE_BUILDING",
        "TESTABLE",
        "SUPPORTED",
        "STRENGTHENED",
        "WEAKENED",
        "REVISED",
        "INVALIDATED",
        "CLOSED"
      ]
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/definitions/transition" }
    },
    "expectation_gap": { "$ref": "#/definitions/expectation_gap" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "status": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "STALE",
        "CONTRADICTED",
        "NOT_ESTABLISHED"
      ]
    },
    "epistemic": {
      "type": "string",
      "enum": [
        "FACT",
        "INFERENCE",
        "HYPOTHESIS",
        "UNKNOWN",
        "CONTRADICTED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "source_locator",
        "known_at",
        "retrieved_at",
        "access",
        "independence_group",
        "epistemic",
        "status",
        "supports",
        "claim_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "source_type": { "type": "string" },
        "source_locator": { "type": "string", "minLength": 3 },
        "published_at": { "type": ["string", "null"], "format": "date" },
        "known_at": { "type": "string", "format": "date" },
        "retrieved_at": { "type": "string", "format": "date" },
        "access": {
          "type": "string",
          "enum": ["PUBLIC", "RESTRICTED", "PRIVATE", "SYNTHETIC"]
        },
        "independence_group": { "type": "string", "minLength": 1 },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "supports": { "type": "boolean" },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "content_hash": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "system_shift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "description",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": { "type": "string" },
        "description": { "type": "string", "minLength": 10 },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "event_date": { "type": ["string", "null"], "format": "date" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "dimensions",
        "state",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 3 },
        "dimensions": { "type": "array", "items": { "type": "string" } },
        "state": {
          "type": "string",
          "enum": [
            "NAMEPLATE",
            "INSTALLED",
            "OPERABLE",
            "QUALIFIED",
            "MERCHANT",
            "CAPTIVE",
            "UNCOMMITTED_AVAILABLE"
          ]
        },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "state_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state", "observed_at", "evidence_ids"],
            "properties": {
              "state": { "type": "string" },
              "observed_at": { "type": "string", "format": "date" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "relationship",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "relationship": { "type": "string" },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "verified_at": { "type": "string", "format": "date" }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "constraint_ids",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 5 },
        "constraint_ids": { "type": "array", "items": { "type": "string" } },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "score",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "mechanism": { "type": "string", "minLength": 5 },
        "score": { "type": "number", "minimum": 0, "maximum": 5 },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "leakage": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capital_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver_to_volume",
        "volume_to_revenue",
        "revenue_to_gross_profit",
        "gross_profit_to_cash",
        "cash_to_capital",
        "capital_to_per_share",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "driver_to_volume": { "type": "string" },
        "volume_to_revenue": { "type": "string" },
        "revenue_to_gross_profit": { "type": "string" },
        "gross_profit_to_cash": { "type": "string" },
        "cash_to_capital": { "type": "string" },
        "capital_to_per_share": { "type": "string" },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "price",
        "shares_outstanding",
        "market_cap",
        "price_as_of",
        "market_cap_method",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "currency": { "type": "string", "minLength": 3 },
        "price": { "type": "number", "minimum": 0 },
        "shares_outstanding": { "type": "number", "minimum": 0 },
        "market_cap": { "type": "number", "minimum": 0 },
        "price_as_of": { "type": "string", "format": "date-time" },
        "market_cap_method": { "type": "string" },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "tolerance": { "type": "number", "minimum": 0, "maximum": 0.25 }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "exposure",
        "capture",
        "capital_bridge",
        "market"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2 },
        "ticker": { "type": "string" },
        "role": { "type": "string" },
        "exposure": { "$ref": "#/definitions/exposure" },
        "capture": { "$ref": "#/definitions/capture" },
        "capital_bridge": { "$ref": "#/definitions/capital_bridge" },
        "market": { "$ref": "#/definitions/market" }
      }
    },
    "expectation_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "market_implied",
        "research_implied",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "claim": { "type": "string", "minLength": 5 },
        "market_implied": { "type": "string", "minLength": 3 },
        "research_implied": { "type": "string", "minLength": 3 },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0_identity_time",
        "G1_dependency_necessity",
        "G2_constraint_reality",
        "G3_edge_verification",
        "G4_capture_proof",
        "G5_financial_transmission",
        "G6_expectation_test",
        "G7_disproof_readiness"
      ],
      "properties": {
        "G0_identity_time": { "$ref": "#/definitions/gate" },
        "G1_dependency_necessity": { "$ref": "#/definitions/gate" },
        "G2_constraint_reality": { "$ref": "#/definitions/gate" },
        "G3_edge_verification": { "$ref": "#/definitions/gate" },
        "G4_capture_proof": { "$ref": "#/definitions/gate" },
        "G5_financial_transmission": { "$ref": "#/definitions/gate" },
        "G6_expectation_test": { "$ref": "#/definitions/gate" },
        "G7_disproof_readiness": { "$ref": "#/definitions/gate" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PASS",
            "PARTIAL",
            "UNKNOWN",
            "STALE",
            "FAIL",
            "CONTRADICTED"
          ]
        },
        "reason": { "type": "string", "minLength": 3 },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "countercase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "claim",
        "epistemic",
        "status",
        "evidence_ids",
        "disproof_plan_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOCAL", "MATERIAL", "FATAL"] },
        "claim": { "type": "string", "minLength": 5 },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "disproof_plan_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disproof_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_claim_id",
        "test",
        "signal",
        "threshold",
        "window",
        "action",
        "owner",
        "epistemic",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "target_claim_id": { "type": "string" },
        "test": { "type": "string", "minLength": 5 },
        "signal": { "type": "string", "minLength": 3 },
        "threshold": { "type": "string", "minLength": 1 },
        "window": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 3 },
        "owner": { "type": "string", "minLength": 1 },
        "epistemic": { "$ref": "#/definitions/epistemic" },
        "status": { "$ref": "#/definitions/status" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "occurred_at",
        "reason",
        "trigger_evidence_ids",
        "case_version"
      ],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 3 },
        "trigger_evidence_ids": { "type": "array", "items": { "type": "string" } },
        "analyst_id": { "type": "string" },
        "case_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
