{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:constraint-assessment",
  "title": "Complete constraint assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["constraint_id", "label", "dimension_assessments", "supply_states", "primary_state", "status", "evidence_ids"],
  "properties": {
    "constraint_id": { "type": "string", "minLength": 3 },
    "label": { "type": "string", "minLength": 3 },
    "dimension_assessments": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "status", "assessment", "as_of", "evidence_ids", "counterevidence_ids", "confidence", "unknowns"],
        "properties": {
          "dimension": { "type": "string", "minLength": 2 },
          "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED", "UNKNOWN"] },
          "assessment": { "type": "string", "minLength": 3 },
          "as_of": { "type": "string", "format": "date-time" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "counterevidence_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "unknowns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "supply_states": { "type": "array", "items": { "$ref": "supply-state.schema.json" } },
    "primary_state": { "type": "string", "enum": ["NAMEPLATE", "INSTALLED", "OPERABLE", "QUALIFIED", "MERCHANT", "CAPTIVE", "UNCOMMITTED_AVAILABLE"] },
    "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED"] },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
