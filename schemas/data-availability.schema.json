{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:data-availability",
  "title": "Data availability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "as_of", "adapters"],
  "properties": {
    "manifest_id": { "type": "string", "minLength": 3 },
    "as_of": { "type": "string", "format": "date-time" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter_id", "provider", "capabilities", "markets", "availability",
          "latency_class", "entitlement_status"
        ],
        "properties": {
          "adapter_id": { "type": "string", "minLength": 2 },
          "provider": { "type": "string", "minLength": 2 },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "markets": { "type": "array", "items": { "type": "string" } },
          "availability": {
            "type": "string",
            "enum": ["AVAILABLE", "DEGRADED", "AUTH_REQUIRED", "UNAVAILABLE", "NOT_SUPPORTED"]
          },
          "latency_class": { "type": "string", "enum": ["REALTIME", "DELAYED", "END_OF_DAY", "BATCH", "UNKNOWN"] },
          "entitlement_status": { "type": "string", "enum": ["ENTITLED", "NOT_ENTITLED", "UNKNOWN"] },
          "last_success_at": { "type": ["string", "null"], "format": "date-time" },
          "last_error": { "type": ["string", "null"] },
          "freshness_policy": { "type": ["string", "null"] }
        }
      }
    }
  }
}
