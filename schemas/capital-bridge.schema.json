{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:capital-bridge",
  "title": "Structured capital bridge",
  "type": "object",
  "additionalProperties": false,
  "required": ["bridge_id", "steps", "status", "evidence_ids"],
  "properties": {
    "bridge_id": { "type": "string", "minLength": 3 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "stage", "from_metric", "to_metric", "mechanism", "input_type", "evidence_ids"],
        "properties": {
          "step_id": { "type": "string", "minLength": 2 },
          "stage": { "type": "string", "enum": ["VOLUME", "REVENUE", "GROSS_PROFIT", "OPERATING_CASH", "REINVESTMENT", "FINANCING", "PER_SHARE"] },
          "from_metric": { "type": "string", "minLength": 2 },
          "to_metric": { "type": "string", "minLength": 2 },
          "mechanism": { "type": "string", "minLength": 3 },
          "baseline": { "type": ["number", "null"] },
          "scenario": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "period": { "type": ["string", "null"] },
          "input_type": { "type": "string", "enum": ["REPORTED", "VERIFIED", "INFERRED", "ASSUMED", "UNKNOWN"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "assumption_ids": { "type": "array", "items": { "type": "string" } },
          "sensitivity": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "UNKNOWN", "NOT_ESTABLISHED"] },
    "evidence_ids": { "type": "array", "items": { "type": "string" } }
  }
}
