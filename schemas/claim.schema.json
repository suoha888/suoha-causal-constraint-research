{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:claim",
  "title": "Canonical research claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "subject",
    "predicate",
    "object",
    "scope",
    "epistemic_type",
    "evidence_state",
    "as_of",
    "confidence",
    "evidence_links",
    "counterevidence_links",
    "unknowns",
    "derivation_access"
  ],
  "properties": {
    "claim_id": { "type": "string", "minLength": 3 },
    "statement": { "type": "string", "minLength": 10 },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "object": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "epistemic_type": {
      "type": "string",
      "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNKNOWN"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED"]
    },
    "as_of": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_links": { "type": "array", "items": { "type": "string" } },
    "counterevidence_links": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "derivation_access": {
      "type": "string",
      "enum": ["PUBLIC", "SYNTHETIC", "RESTRICTED", "PRIVATE", "MIXED"]
    },
    "derived_from_ids": { "type": "array", "items": { "type": "string" } },
    "public_support_ids": { "type": "array", "items": { "type": "string" } }
  }
}
