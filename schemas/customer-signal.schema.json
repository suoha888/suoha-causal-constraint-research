{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:suoha:causal-constraint-research:customer-signal",
  "title": "Customer validation signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "signal_type", "customer_identity_status", "supplier_id", "binding_status", "effective_period", "evidence_ids", "status"],
  "properties": {
    "signal_id": { "type": "string", "minLength": 3 },
    "signal_type": { "type": "string", "enum": ["QUALIFICATION", "DESIGN_WIN", "PURCHASE_ORDER", "REPEAT_ORDER", "LTA", "PREPAYMENT", "CAPACITY_RESERVATION", "TAKE_OR_PAY", "CUSTOMER_CAPEX_SUPPORT", "SECOND_SOURCE", "CANCELLATION", "DELAY", "OTHER"] },
    "customer_id": { "type": ["string", "null"] },
    "customer_identity_status": { "type": "string", "enum": ["NAMED", "ANONYMIZED", "UNCONFIRMED", "UNKNOWN"] },
    "supplier_id": { "type": "string", "minLength": 2 },
    "binding_status": { "type": "string", "enum": ["BINDING", "NON_BINDING", "CANCELLED", "UNKNOWN"] },
    "quantity": { "type": ["number", "null"] },
    "currency": { "type": ["string", "null"] },
    "effective_period": { "type": "string", "minLength": 2 },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "STALE", "CONTRADICTED", "NOT_ESTABLISHED", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
